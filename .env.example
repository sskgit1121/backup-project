# 12-Factor App Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local or production environments

# Database Credentials & URLs
DB_USERNAME=postgres
DB_PASSWORD=admin1234
DB_URL_AUTH=jdbc:postgresql://localhost:5432/auth_db
DB_URL_ECOMMERCE=jdbc:postgresql://localhost:5432/ecommerce_db
DB_URL_INVENTORY=jdbc:postgresql://localhost:5432/inventory_db

# MongoDB URI
MONGODB_URI=mongodb://localhost:27017/product_db

# Redis Cache & Rate Limiter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Message Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Eureka Service Registry
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# JWT Authentication & Cryptographic Keys
JWT_SECRET_KEY=SagarWorkspaceSskSecretKeyForPolyglotSaasErpProductionEnterpriseSystemKeyLengthMustBeLongEnough
JWT_ISSUER_URI=http://localhost:8081
JWT_JWK_SET_URI=http://localhost:8081/api/v1/auth/certs

# Logging Levels
LOG_SECURITY_LEVEL=DEBUG
LOG_OAUTH2_LEVEL=TRACE
